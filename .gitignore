# Runtime state and secrets - NEVER version
v2/
workspace/
plugin-workspace/
# CLI: everything under cli/ is runtime state, version only the config and
# the marketplace registry; any future runtime directory is ignored by
# default (cli/* excludes the contents, so the re-inclusions below work)
cli/*
!cli/config.json
!cli/plugins/
cli/plugins/*
!cli/plugins/known_marketplaces.json
plan/
.opencode-memory/
# Python bytecode caches: regenerated from source on every interpreter run
__pycache__/
