{
  "provider": {
    "failover": {
      "kind": "openai-compatible",
      "name": "Failover",
      "options": {
        "baseURL": "http://127.0.0.1:4490/v1",
        "apiKey": "failover-local"
      },
      "models": {
        "security-auditor": {
          "name": "Failover security-auditor",
          "tool_call": true
        },
        "performance-auditor": {
          "name": "Failover performance-auditor",
          "tool_call": true
        },
        "architecture-auditor": {
          "name": "Failover architecture-auditor",
          "tool_call": true
        },
        "audit-critic": {
          "name": "Failover audit-critic",
          "tool_call": true
        },
        "implementer": {
          "name": "Failover implementer",
          "tool_call": true
        },
        "pcb-creator": {
          "name": "Failover pcb-creator",
          "tool_call": true
        },
        "pcb-designer": {
          "name": "Failover pcb-designer",
          "tool_call": true
        },
        "pcb-emc-auditor": {
          "name": "Failover pcb-emc-auditor",
          "tool_call": true
        },
        "pcb-schematic-auditor": {
          "name": "Failover pcb-schematic-auditor",
          "tool_call": true
        },
        "pcb-spice-auditor": {
          "name": "Failover pcb-spice-auditor",
          "tool_call": true
        }
      }
    }
  },
  "mcp": {
    "servers": {
      "opencode-memory-global": {
        "type": "stdio",
        "command": "/Users/macbook/.local/bin/opencode-memory",
        "args": [
          "global"
        ],
        "env": {
          "MCP_EXTERNAL_EMBEDDING_URL": "http://192.168.1.37:11434/v1/embeddings",
          "MCP_EXTERNAL_EMBEDDING_MODEL": "qwen3-embedding",
          "MCP_EXTERNAL_EMBEDDING_DIM": "2560"
        }
      },
      "opencode-memory-project": {
        "type": "stdio",
        "command": "/Users/macbook/.local/bin/opencode-memory",
        "args": [
          "project"
        ],
        "env": {
          "MCP_EXTERNAL_EMBEDDING_URL": "http://192.168.1.37:11434/v1/embeddings",
          "MCP_EXTERNAL_EMBEDDING_MODEL": "qwen3-embedding",
          "MCP_EXTERNAL_EMBEDDING_DIM": "2560"
        }
      },
      "chrome-devtools": {
        "type": "stdio",
        "command": "npx",
        "args": [
          "-y",
          "chrome-devtools-mcp@latest"
        ]
      },
      "context7": {
        "type": "http",
        "url": "https://mcp.context7.com/mcp"
      }
    }
  },
  "plugins": {
    "dirs": [
      "~/.agents/agents-plugin"
    ],
    "extraKnownMarketplaces": {
      "kicad-happy": {
        "source": {
          "source": "github",
          "repo": "aklofas/kicad-happy"
        }
      },
      "shared-agents": {
        "source": {
          "source": "directory",
          "path": "~/.agents/agents-plugin"
        }
      }
    },
    "enabledPlugins": {
      "shared-agents@shared-agents": true,
      "shared-agents": true,
      "computer-use@zcode-plugins-official": true
    }
  },
  "hooks": {
    "enabled": true,
    "events": {
      "PreToolUse": [
        {
          "matcher": "Bash",
          "hooks": [
            {
              "type": "command",
              "command": "python3 \"$HOME/.zcode/hooks/bash_guard.py\"",
              "timeout": 5
            }
          ]
        }
      ],
      "PostToolUse": [
        {
          "matcher": "Bash",
          "hooks": [
            {
              "type": "command",
              "command": "node \"$HOME/.zcode/hooks/experience_recorder.mjs\"",
              "timeout": 5
            }
          ]
        },
        {
          "matcher": "Edit|Write|NotebookEdit",
          "hooks": [
            {
              "type": "command",
              "command": "node \"$HOME/.zcode/hooks/experience_recorder.mjs\"",
              "timeout": 5
            }
          ]
        }
      ],
      "PostToolUseFailure": [
        {
          "matcher": "Bash",
          "hooks": [
            {
              "type": "command",
              "command": "node \"$HOME/.zcode/hooks/experience_recorder.mjs\"",
              "timeout": 5
            }
          ]
        }
      ]
    }
  }
}